{
  "name": "expo-native-mqtt",
  "version": "0.4.0",
  "description": "Native MQTT client for Expo with auto-reconnect and offline delivery support",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "expo-module.config.json",
    "app.plugin.js",
    "index.ts"
  ],
  "keywords": [
    "expo",
    "react-native",
    "mqtt"
  ],
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@types/jest": "^29.5.14",
    "expo-modules-core": "^57.0.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  }
}
