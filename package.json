    "@types/react": "~19.2.4",
    "expo": "^57.0.16",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
