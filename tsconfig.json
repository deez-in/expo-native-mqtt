{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-native",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "strict": true,
    "target": "es2020",
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "build", "ios", "android"]
}
